{
  "git": { "deploymentEnabled": { "main": false } },
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "lang", "value": "en" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "lang", "value": "ru" }],
      "destination": "/ru",
      "permanent": true
    },
    {
      "source": "/dl",
      "destination": "https://github.com/Yevgeniy204566/totalhunter/releases/latest/download/TotalHunter.zip",
      "permanent": false
    },
    {
      "source": "/tg",
      "destination": "https://t.me/Total_Hunter",
      "permanent": false
    },
    {
      "source": "/r/:code",
      "destination": "/ref/:code",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/dashboard/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/login",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/ru/login",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://api.total-hunter.com/$1" },
    { "source": "/((?!api/|img/|.*\\..*).*)", "destination": "/index.html" }
  ]
}